# ---------------------------------------------------------------
# Data
# ---------------------------------------------------------------
# The raw Kaggle CSVs are ~1.3 GB combined and the processed files
# ~1.1 GB. GitHub rejects any single file over 100 MB, so the data
# is never committed. See data/README.md for download instructions.
data/raw/
data/processed/
*.csv

# ...but the small committed samples are the exception
!data/sample/*.csv

# ---------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# The original walkthrough notebook this EDA was built from. Local reference
# only - delete this line if you do want it in the repo.
EDA_UK_Road_Safety.ipynb

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.ipynb_checkpoints
.python-version

# ---------------------------------------------------------------
# Tableau
# ---------------------------------------------------------------
# Packaged workbooks (.twbx) are committed; local temp files are not
*.twb.bak
*.hyper
*.tde

