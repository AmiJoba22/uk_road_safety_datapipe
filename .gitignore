# ---------------------------------------------------------------
# Data
# ---------------------------------------------------------------
# The raw Kaggle CSVs are ~1.3 GB combined and the cleaned files
# ~1.1 GB. GitHub rejects any single file over 100 MB, so the data
# lives in these folders locally but is never committed.
# Download the raw files from Kaggle:
# https://www.kaggle.com/datasets/tsiaras/uk-road-safety-accidents-and-vehicles
data/raw/
data/preprocessed/
*.csv

# keep the folder structure in the repo even though the data isn't
!data/raw/.gitkeep
!data/preprocessed/.gitkeep

# ---------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.python-version

# ---------------------------------------------------------------
# Tableau
# ---------------------------------------------------------------
# Packaged workbooks (.twbx) are committed; local temp files are not
*.twb.bak
*.hyper
*.tde

# ---------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
