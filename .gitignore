# ---------------------------------------------------------------
# Data
# ---------------------------------------------------------------
# The raw Kaggle CSVs are ~1.3 GB combined and the cleaned files
# ~1.1 GB. GitHub rejects any single file over 100 MB, so the data
# lives in these folders locally but is never committed.
# Download the raw files from Kaggle:
# https://www.kaggle.com/datasets/tsiaras/uk-road-safety-accidents-and-vehicles
data/raw/*
data/preprocessed/*
*.csv

# keep the folder structure in the repo even though the data isn't
!data/raw/.gitkeep
!data/preprocessed/.gitkeep

# ...and the cluster labels from models/unsupervised_clustering.ipynb are the
# exception: two columns, ~5.6 MB gzipped, so the supervised notebook can just
# read them after a git pull instead of re-running the clustering
!data/preprocessed/accident_clusters.csv.gz

# ---------------------------------------------------------------
# Notebooks
# ---------------------------------------------------------------
.ipynb_checkpoints/
*/.ipynb_checkpoints/*

# ---------------------------------------------------------------
# Python
# ---------------------------------------------------------------
__pycache__/
*.py[cod]
.venv/
venv/
env/
.python-version

# ---------------------------------------------------------------
# Tableau
# ---------------------------------------------------------------
# Packaged workbooks (.twbx) are committed; local temp files are not
*.twb.bak
*.hyper
*.tde

# ---------------------------------------------------------------
# OS / editor
# ---------------------------------------------------------------
.DS_Store
Thumbs.db
.vscode/
.idea/
dashboard/screenshots/tableau_morris_part.ipynb
